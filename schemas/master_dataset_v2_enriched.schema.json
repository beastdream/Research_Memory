{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.1"
    },
    "canonical_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "const": "arxiv"
    },
    "source_id": {
      "type": "string"
    },
    "split": {
      "const": "corpus"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "abstract": {
      "type": "string"
    },
    "year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1800,
      "maximum": 2200
    },
    "identifiers": {
      "type": "object",
      "properties": {
        "arxiv_id": {
          "type": "string"
        },
        "arxiv_version": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^v[1-9][0-9]*$"
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "openalex_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "arxiv_id",
        "arxiv_version",
        "doi"
      ]
    },
    "publication": {
      "type": "object",
      "properties": {
        "arxiv_first_submitted_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "arxiv_updated_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "journal_publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "venue": {
          "type": [
            "string",
            "null"
          ]
        },
        "journal_publication_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1800,
          "maximum": 2200
        },
        "publication_status": {
          "enum": [
            "preprint",
            "published",
            "unknown"
          ]
        }
      },
      "required": [
        "arxiv_first_submitted_date",
        "arxiv_updated_date",
        "journal_publication_date",
        "venue",
        "journal_publication_year",
        "publication_status"
      ]
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "full_text": {
      "type": "object",
      "required": [
        "sections",
        "extraction_status"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "section_id",
              "heading",
              "paragraphs",
              "extraction_status"
            ],
            "properties": {
              "section_id": {
                "type": "string",
                "minLength": 1
              },
              "heading": {
                "type": "string"
              },
              "paragraphs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "paragraph_id",
                    "text",
                    "page_start",
                    "page_end"
                  ],
                  "properties": {
                    "paragraph_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "page_start": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "page_end": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    }
                  }
                }
              },
              "extraction_status": {
                "enum": [
                  "pending",
                  "complete",
                  "partial",
                  "failed",
                  "not_applicable"
                ]
              }
            }
          }
        },
        "extraction_status": {
          "enum": [
            "pending",
            "complete",
            "partial",
            "failed",
            "not_applicable"
          ]
        }
      }
    },
    "qas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "qa_id",
          "paper_id",
          "question",
          "answer",
          "answer_type",
          "source_type",
          "split",
          "evidence_refs",
          "validation_status"
        ],
        "properties": {
          "qa_id": {
            "type": "string",
            "minLength": 1
          },
          "paper_id": {
            "type": "string"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "enum": [
              "human_annotated",
              "synthetic"
            ]
          },
          "split": {
            "enum": [
              "train",
              "validation",
              "test",
              null
            ]
          },
          "validation_status": {
            "enum": [
              "candidate",
              "human_annotated",
              "human_verified"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "section_id",
                "paragraph_id",
                "quoted_evidence"
              ],
              "properties": {
                "section_id": {
                  "type": "string"
                },
                "paragraph_id": {
                  "type": "string"
                },
                "quoted_evidence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "figures_and_tables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "figure",
              "table"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "caption": {
            "type": [
              "string",
              "null"
            ]
          },
          "data": {},
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "image_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "extraction_status": {
            "enum": [
              "complete",
              "partial",
              "failed"
            ]
          }
        },
        "required": [
          "item_id",
          "type",
          "label",
          "caption",
          "data",
          "text",
          "image_path",
          "page",
          "extraction_status",
          "section_id",
          "source_bbox"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "table"
                }
              }
            },
            "then": {
              "required": [
                "table_id",
                "headers",
                "rows",
                "units",
                "raw_text"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "figure"
                }
              }
            },
            "then": {
              "required": [
                "figure_id",
                "description"
              ]
            }
          }
        ]
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "raw_reference": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "year": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1800,
            "maximum": 2200
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "arxiv_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolution_status": {
            "enum": [
              "resolved",
              "unresolved",
              "partial",
              "failed"
            ]
          },
          "reference_id": {
            "type": "string",
            "minLength": 1
          },
          "authors": {
            "type": "array"
          },
          "target_paper_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "citation_contexts": {
            "type": "array"
          },
          "extraction_status": {
            "enum": [
              "pending",
              "complete",
              "partial",
              "failed",
              "not_applicable"
            ]
          }
        },
        "required": [
          "raw_reference",
          "title",
          "year",
          "doi",
          "arxiv_id",
          "resolution_status",
          "reference_id",
          "authors",
          "target_paper_id",
          "citation_contexts",
          "extraction_status"
        ]
      }
    },
    "has_full_text": {
      "type": "boolean"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "metadata_source": {
          "type": "string"
        },
        "pdf_path": {
          "type": "string"
        },
        "pdf_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "license_status": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "processed_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "metadata_source",
        "pdf_path",
        "pdf_sha256",
        "license",
        "license_status",
        "processed_at_utc"
      ]
    },
    "extraction_quality": {
      "type": "object",
      "properties": {
        "parser": {
          "type": "string"
        },
        "structure_status": {
          "type": "string"
        },
        "status": {
          "enum": [
            "full_text",
            "insufficient_text"
          ]
        },
        "criteria": {
          "type": "string"
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "parser",
        "structure_status",
        "status",
        "criteria",
        "word_count",
        "page_count"
      ]
    },
    "citation_markers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "marker",
          "page",
          "offset",
          "resolution_status"
        ],
        "properties": {
          "marker": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "resolution_status": {
            "const": "unresolved"
          }
        }
      }
    },
    "research_metadata": {
      "type": "object",
      "required": [
        "methods",
        "datasets",
        "metrics",
        "claimed_contributions"
      ],
      "properties": {
        "methods": {
          "type": "array"
        },
        "datasets": {
          "type": "array"
        },
        "metrics": {
          "type": "array"
        },
        "claimed_contributions": {
          "type": "array"
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "full_text_status",
        "structure_status",
        "qa_status"
      ],
      "properties": {
        "full_text_status": {
          "enum": [
            "pending",
            "complete",
            "partial",
            "failed",
            "not_applicable"
          ]
        },
        "structure_status": {
          "type": "string"
        },
        "qa_status": {
          "type": "string"
        },
        "figures_status": {
          "enum": [
            "pending",
            "complete",
            "partial",
            "failed",
            "not_applicable"
          ]
        },
        "tables_status": {
          "enum": [
            "pending",
            "complete",
            "partial",
            "failed",
            "not_applicable"
          ]
        },
        "references_status": {
          "enum": [
            "pending",
            "complete",
            "partial",
            "failed",
            "not_applicable"
          ]
        },
        "research_metadata_status": {
          "enum": [
            "pending",
            "complete",
            "partial",
            "failed",
            "not_applicable"
          ]
        },
        "equations_status": {
          "enum": [
            "pending",
            "complete",
            "partial",
            "failed",
            "not_applicable"
          ]
        }
      }
    },
    "equations": {
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "canonical_id",
    "source",
    "source_id",
    "split",
    "title",
    "abstract",
    "year",
    "identifiers",
    "publication",
    "authors",
    "categories",
    "full_text",
    "qas",
    "figures_and_tables",
    "references",
    "has_full_text",
    "provenance",
    "extraction_quality",
    "research_metadata",
    "quality",
    "equations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchmemory.local/schemas/arxiv-master-v2-enriched",
  "title": "ResearchMemory enriched Master v2 (2.1, legacy readers use sections alias)"
}
